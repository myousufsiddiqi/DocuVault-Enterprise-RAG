# Application Settings
PROJECT_NAME="DocuVault AI: Enterprise Document Intelligence & Hybrid RAG Workbench"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

# PostgreSQL / pgvector Database (Local Docker - 100% Free)
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="docuvault"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ==============================================================================
# 100% FREE AI CONFIGURATION
# ==============================================================================

# 1. Track A: Groq API Key (Free tier from https://console.groq.com)
# Paste your Groq API key below when ready:
GROQ_API_KEY=""
GROQ_EXTRACTION_MODEL="llama-3.3-70b-versatile"

# 2. Track B: Local Vector Embeddings (100% FREE - No API key needed)
# Uses FastEmbed (ONNX) running locally on CPU (384 dimensions)
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# 3. Track B: Local Cross-Encoder Reranker (100% FREE - No API key needed)
# Uses FlashRank running locally on CPU in ~15ms
RERANK_PROVIDER="flashrank"
RERANK_MODEL="ms-marco-MiniLM-L-12-v2"

# ==============================================================================
# OPTIONAL CLOUD PROVIDERS (Leave empty if using 100% free mode)
# ==============================================================================
OPENAI_API_KEY=""
COHERE_API_KEY=""
